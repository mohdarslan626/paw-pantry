
# PostgreSQL
POSTGRES_PASSWORD=change_me
DATABASE_URL=postgresql+psycopg://paw_pantry_user:change_me@db:5432/paw_pantry

# JWT Authentication
JWT_SECRET_KEY=change_me_use_a_long_random_value
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Application
SEED_ON_STARTUP=true

# Frontend API
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Image Upload
MAX_UPLOAD_BYTES=10485760
CLAMAV_TIMEOUT_SECONDS=20

# SMTP - Mailpit (Local Development)
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USE_TLS=false
SMTP_FROM_EMAIL=noreply@pawpantry.local

# Password Recovery
FRONTEND_URL=http://localhost:5173
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=15
